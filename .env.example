# ─────────────────────────────────────────────────────────────────────────────
# IRIS — Intelligent Risk Integration System
# Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file and rename it to .env
# Fill in your actual values in .env
# NEVER commit .env to GitHub — it contains your real API keys
# ─────────────────────────────────────────────────────────────────────────────

# Trading Economics API
# Get your key at: https://tradingeconomics.com/api/
TRADING_ECONOMICS_API_KEY=your_api_key_here

# App settings
APP_TITLE=IRIS — Intelligent Risk Integration System
APP_VERSION=1.0.0
REFRESH_INTERVAL_MINUTES=60

# Risk score thresholds (0-100)
STABLE_MAX=25
MODERATE_MAX=50
DANGER_MAX=75
# Above 75 = Critical

# Data settings
HISTORICAL_START_YEAR=1971
CACHE_EXPIRY_HOURS=1